generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PATIENT
  DOCTOR
}

enum QuestionStatus {
  OPEN
  CLOSED
}

enum QuestionCategory {
  GENERAL
  SYMPTOMS
  MEDICATION
  DIAGNOSIS
  OTHER
}

model Tag {
  id   String @id @default(uuid())
  name String @unique
}

model User {
  id                String    @id @default(uuid())
  display_name      String
  role              UserRole
  is_verified_doctor Boolean @default(false)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  questions      Question[]
  answers        Answer[]
  questionVotes  QuestionVote[]
  answerVotes    AnswerVote[]
}

model Question {
  id        String             @id @default(uuid())
  author_id String
  title     String
  body      String
  tags      String[]
  category  QuestionCategory   @default(GENERAL)
  status    QuestionStatus     @default(OPEN)
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt

  author        User           @relation(fields: [author_id], references: [id], onDelete: Cascade)
  answers       Answer[]
  questionVotes QuestionVote[]
}

model QuestionVote {
  user_id     String
  question_id String
  created_at  DateTime @default(now())

  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  question Question @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@id([user_id, question_id])
}

model Answer {
  id          String   @id @default(uuid())
  question_id String
  doctor_id   String
  body        String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  question    Question     @relation(fields: [question_id], references: [id], onDelete: Cascade)
  doctor      User         @relation(fields: [doctor_id], references: [id], onDelete: Cascade)
  answerVotes AnswerVote[]
}

model AnswerVote {
  user_id   String
  answer_id String
  created_at DateTime @default(now())

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  answer Answer @relation(fields: [answer_id], references: [id], onDelete: Cascade)

  @@id([user_id, answer_id])
}
